---
layout: base.njk
navKey: blog
title: The Blog
description: Thoughts, research, interviews, and conversations about skin health.
permalink: /blog/
---
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h1 class="display">{{ pages.blog.heading }}</h1>
      <p class="lede" style="margin-top:18px">{{ pages.blog.sub }}</p>
    </div>

    {% set items = collections.posts | newestFirst %}
    {% if items %}
    <div class="posts">
      {% for item in items %}
      <a class="post" href="{{ item.url }}">
        <div class="thumb">{% if item.data.icon %}{{ item.data.icon }}{% else %}&#129378;{% endif %}</div>
        <div class="body">
          {% if item.data.category %}<p class="tag">{{ item.data.category }}</p>{% endif %}
          <h3>{{ item.data.title }}</h3>
          <p>{{ item.data.summary }}</p>
          <span class="go">Read Article &#8594;</span>
        </div>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty"><p>No posts yet. Add one in the admin area under Blog Posts.</p></div>
    {% endif %}
  </div>
</section>
