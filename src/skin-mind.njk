---
layout: base.njk
navKey: mind
title: Skin + Mind
description: Because skin health is about more than what we see in the mirror.
permalink: /skin-mind/
---
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h1 class="display">Skin + Mind</h1>
      <p class="lede" style="margin-top:18px">Because skin health is about more than what we see in the mirror.</p>
    </div>

    {% set items = collections.articles | newestFirst %}
    {% if items %}
    <div class="cards">
      {% for item in items %}
      <a class="card" href="{{ item.url }}">
        <div class="frame">
          {% if item.data.image %}
          <img src="{{ item.data.image }}" alt="{{ item.data.title }}">
          {% else %}
          <svg viewBox="0 0 520 292" role="img" aria-label="Placeholder image">
            <rect width="520" height="292" fill="#FAF1ED"/>
            <g font-family="Montserrat, sans-serif" font-size="9" letter-spacing="4" fill="#2E2724" opacity=".34"><text x="216" y="150">IMAGE</text></g>
          </svg>
          {% endif %}
        </div>
        <div class="body">
          <h3>{{ item.data.title }}</h3>
          <p>{{ item.data.summary }}</p>
          <span class="go">Read Article &#8594;</span>
        </div>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty"><p>No articles yet. Add one in the admin area under Skin + Mind Articles.</p></div>
    {% endif %}
  </div>
</section>
